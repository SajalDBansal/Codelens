# Human-readable guide and support files needed by the documented source workflows.
include README.md LICENSE CHANGELOG.md requirements.txt
recursive-include docs *.md
include scripts/smoke_local.py scripts/test_recovery.py
recursive-include evals *.py *.json
recursive-include examples *.py *.md
recursive-include tests *.py
recursive-include constraints *.txt
prune .github

# Local environments, graphs, and generated build output are not source artifacts.
prune .venv
prune .venv-*
prune test-results
prune .codelens
prune .pytest_cache
prune .ruff_cache
prune build
prune dist
prune dist-*
prune planning
global-exclude *.pyc *.pyo *.lbug *.lbug.*
